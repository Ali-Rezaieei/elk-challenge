# {{ ansible_managed }}
# Rendered by Ansible. Do not edit on the host - overwritten on the next deploy.

cluster.name: "{{ es_cluster_name }}"
node.name: "{{ es_node_name }}"

# Data and log directories. This file REPLACES the packaged elasticsearch.yml,
# so the deb's own path.data/path.logs defaults are gone. Without them, ES falls
# back to $ES_HOME/{data,logs} under /usr/share/elasticsearch, which the
# 'elasticsearch' service user cannot create - it then dies during logging init,
# before it can write a single log line. Point both at the package-owned dirs.
path.data: /var/lib/elasticsearch
path.logs: /var/log/elasticsearch

# Bind the REST/HTTP listener to loopback only. nginx (same host) is the sole
# public entry point; 9200 is never exposed and never in the firewall.
network.host: {{ elasticsearch_bind_host }}
http.port: {{ elasticsearch_http_port }}

# Single-node cluster: skips the multi-node discovery/quorum bootstrap checks.
discovery.type: single-node

# --- Authentication --------------------------------------------------------
xpack.security.enabled: true

# --- TLS on the HTTP (REST) layer -----------------------------------------
# This makes Elasticsearch reachable only over HTTPS. nginx proxies to it over
# this listener and verifies the internal CA. Paths are relative to ES_PATH_CONF.
xpack.security.http.ssl.enabled: true
xpack.security.http.ssl.key: certs/es.key
xpack.security.http.ssl.certificate: certs/es.crt
xpack.security.http.ssl.certificate_authorities: ["certs/ca.crt"]

# --- TLS on the transport layer -------------------------------------------
# Defense in depth: even single-node transport traffic is encrypted and
# authenticated with the same internal CA.
xpack.security.transport.ssl.enabled: true
xpack.security.transport.ssl.verification_mode: certificate
xpack.security.transport.ssl.key: certs/es.key
xpack.security.transport.ssl.certificate: certs/es.crt
xpack.security.transport.ssl.certificate_authorities: ["certs/ca.crt"]
