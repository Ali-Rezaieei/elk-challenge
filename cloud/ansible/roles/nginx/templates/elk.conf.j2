# {{ ansible_managed }}
# TLS termination + reverse proxy. The single public entry point (443).

server {
    # HTTP/2 is enabled on the listen line: Ubuntu 24.04 ships nginx 1.24, where
    # the standalone `http2 on;` directive (nginx >= 1.25.1) does not exist yet.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ public_ipv4 }};

    ssl_certificate     {{ nginx_certs_dir }}/nginx.crt;
    ssl_certificate_key {{ nginx_certs_dir }}/nginx.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # We only ever serve HTTPS, so HSTS is safe to assert.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "no-referrer" always;

    # Kibana bundle uploads and ES bulk requests can be large.
    client_max_body_size 100m;

    # --- Elasticsearch REST API, namespaced under /es/ --------------------
    location /es/ {
        rewrite ^/es/(.*)$ /$1 break;
        proxy_pass https://127.0.0.1:9200;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate {{ nginx_certs_dir }}/ca.crt;
        # The ES leaf cert's SAN covers 'localhost'; match it (SNI + verify).
        proxy_ssl_name localhost;
        proxy_ssl_server_name on;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # --- Kibana UI at the root --------------------------------------------
    location / {
        proxy_pass https://127.0.0.1:5601;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate {{ nginx_certs_dir }}/ca.crt;
        proxy_ssl_name localhost;
        proxy_ssl_server_name on;

        # Kibana uses websockets; forward the upgrade handshake.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 180s;
    }
}
